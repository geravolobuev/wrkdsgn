# Telegram Scraper
TG_API_ID=
TG_API_HASH=
TG_PHONE=
SOURCE_CHANNEL=
SOURCE_CHANNELS=@bbe_jobs
TELETHON_SESSION_NAME=telegram_session
FETCH_LIMIT=30

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI enrichment (OpenRouter, free models)
ENABLE_AI_ENRICHMENT=true
# Primary provider: Ollama API (cloud/local)
OLLAMA_ENABLED=false
OLLAMA_API_URL=https://ollama.com/api/chat
# Required when OLLAMA_ENABLED=true
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Provider: OpenRouter (primary + fallback)
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT=10
OPENROUTER_MAX_RETRIES=1
# Optional: append generic OpenRouter fallback model at end of chain.
OPENROUTER_INCLUDE_GENERIC_FALLBACK=true
ENRICHMENT_VERSION=v1

# Optional aliases matching generic naming
API_ID=
API_HASH=

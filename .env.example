OPENROUTER_INCLUDE_GENERIC_FALLBACK=true
ENABLE_SEMANTIC_SEARCH=false
ENABLE_AI_RERANK=true
ENABLE_AI_QUERY_EXPANSION=true
SEARCH_MIN_RELEVANCE_SCORE=60
OPENROUTER_SEARCH_MODEL=openai/gpt-oss-120b:free
EMBEDDING_MODEL_PRIMARY=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_MODEL_FALLBACK=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_TIMEOUT=15
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_TEXT_MAX_CHARS=2500
ENRICHMENT_VERSION=v1

# Optional aliases matching generic naming
API_ID=
API_HASH=
